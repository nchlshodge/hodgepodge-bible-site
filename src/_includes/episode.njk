---
layout: base.njk
section: podcast
---
<article class="article">
  <a class="back-link" href="/podcast/">← Podcast</a>
  <span class="label kicker article-kicker">Episode {{ episodeNumber }} · {{ duration }}</span>
  <h1 class="display article-title balance">{{ title }}</h1>
  <div class="article-meta">
    <a class="pill" href="{{ site.podcast.applePodcasts }}">Apple Podcasts</a>
    <a class="pill" href="{{ site.podcast.spotify }}">Spotify</a>
    <a class="pill" href="{{ site.podcast.youtube }}">YouTube</a>
  </div>
  <div class="article-body">
    {{ content | safe }}
  </div>
</article>
