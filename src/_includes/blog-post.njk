---
layout: base.njk
section: blog
---
<article class="article">
  <a class="back-link" href="/blog/">← Field Notes</a>
  <span class="label kicker article-kicker">{{ tag }}</span>
  <h1 class="display article-title balance">{{ title }}</h1>
  <div class="article-meta"><span>{{ date | readableDate }}</span></div>
  <div class="article-body">
    {{ content | safe }}
  </div>
</article>
