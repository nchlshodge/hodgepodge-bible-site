---
layout: base.njk
title: Field Notes
section: blog
---
<div class="page-head">
  <span class="label kicker">Field Notes</span>
  <h1 class="h1 display balance">Where the news gets loud, here's the text underneath it.</h1>
</div>
<div class="listing">
  {% for post in collections.blogPosts %}
  <div class="listing-item">
    <div>
      <span class="post-tag">{{ post.data.tag }}</span>
      <div class="post-title" style="margin-top:8px;"><a href="{{ post.url }}">{{ post.data.title }}</a></div>
      <p class="post-dek" style="margin-top:8px;">{{ post.data.dek }}</p>
      <div class="post-meta">{{ post.data.date | readableDate }}</div>
    </div>
  </div>
  {% else %}
  <p style="color:var(--text-dark-muted)">No Field Notes posts yet — the first one's coming soon.</p>
  {% endfor %}
</div>
